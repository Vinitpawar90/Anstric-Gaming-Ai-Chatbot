# Application
APP_NAME=Siemens
APP_URL=http://localhost:8000

# Security
JWT_SECRET=your-super-secure-256-bit-secret-key-that-is-at-least-32-chars-long
PORT=8000

# SQLite Database (local file — no external DB needed)
DB_PATH=./data/local.db

# AI Provider Keys
GROQ_API_KEY=your-groq-api-key

# Pinecone (Vector DB)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name

# HuggingFace (Embeddings)
HUGGINGFACE_TOKEN=your-hf-token

# Queue Configuration (in-process — no Redis needed)
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT=300000

# Local File Uploads Directory (relative to backend root)
UPLOADS_DIR=./uploads

# Email Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Security Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
